# build.sh 的产物, 每次编译重生成
/build/

# 参考工程, 自带 .git 且 52MB, 不纳入本仓库
/magnetic-levitation/

# MRS 在 obj/ 下的构建产物。makefile / *.mk 是构建系统本体, 必须保留,
# 只忽略编译出来的东西。
CH32V203G6U/obj/**/*.o
CH32V203G6U/obj/**/*.d
CH32V203G6U/obj/*.elf
CH32V203G6U/obj/*.hex
CH32V203G6U/obj/*.bin
CH32V203G6U/obj/*.map
CH32V203G6U/obj/*.lst

__pycache__/
*.pyc
